# ─────────────────────────────────────────────────────────────
# Zeppstr Web — Environment Variables
# Copy this to .env.local and fill in values for local dev.
# Production values live in Vercel project settings.
# ─────────────────────────────────────────────────────────────

# Site
NEXT_PUBLIC_SITE_URL=https://zeppstr.com

# Sanity CMS — project: Zeppstr (org: UINITISH)
NEXT_PUBLIC_SANITY_PROJECT_ID=03uhyc94
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_VERSION=2024-01-01
SANITY_API_TOKEN=                          # read+write token (server-only) — paste from password manager
SANITY_REVALIDATE_SECRET=                  # webhook secret for ISR (generate any random string)
# Organization ID (for reference): omFAG11Md

# Newsletter — Beehiiv
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=

# CRM — choose one
CRM_PROVIDER=                              # hubspot | zoho | pipedrive | sheet
CRM_API_KEY=
CRM_API_URL=

# Transactional Email — Resend
RESEND_API_KEY=
ZEPPSTR_FROM_EMAIL="Zeppstr Website <noreply@zeppstr.com>"   # requires domain verification in Resend
ZEPPSTR_INBOX=nitish@zeppstr.com                              # where form submissions land
NOTIFY_EMAIL=nitish@zeppstr.com                               # legacy alias — kept for backwards compat

# Spam protection — Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Analytics
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=zeppstr.com
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_CLARITY_ID=

# Sentry
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=                    # client-side DSN (can be same as server)
SENTRY_AUTH_TOKEN=                         # for source-map uploads at build time

# ─────────────────────────────────────────────────────────────
# Live chat widget — components/utility/LiveChat.tsx
# Set ONE of these. If neither is set, no chat widget renders and
# the site is unaffected. Both IDs are public by design (they appear
# in page source on every site running these widgets) — they identify
# a property, they do not authenticate anything.
# ─────────────────────────────────────────────────────────────

# Tawk.to — Administration → Channels → Chat Widget
# Embed URL looks like https://embed.tawk.to/<PROPERTY>/<WIDGET>
NEXT_PUBLIC_TAWK_PROPERTY_ID=
NEXT_PUBLIC_TAWK_WIDGET_ID=

# Crisp — Settings → Setup instructions → CRISP_WEBSITE_ID (a UUID)
NEXT_PUBLIC_CRISP_WEBSITE_ID=
